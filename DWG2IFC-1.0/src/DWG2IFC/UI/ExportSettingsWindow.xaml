<Window x:Class="Plant3D.IfcExporter.UI.ExportSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DWG2IFC — Export to IFC (AutoCAD / Plant 3D 2025–2026)"
        Height="540" Width="680"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#1B1E23"
        Foreground="#E2E8F0"
        FontFamily="Segoe UI" FontSize="12">

    <Window.Resources>
        <Style TargetType="GroupBox">
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="BorderBrush" Value="#383E4A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#252830"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#3E4452"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#252830"/>
            <Setter Property="Foreground" Value="#000000"/>
            <Setter Property="BorderBrush" Value="#3E4452"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#D0D5DD"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header with Author link -->
        <Border Grid.Row="0" Background="#262A32" BorderBrush="#3A404D" BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="📐" FontSize="20" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="DWG2IFC — Export to IFC" FontWeight="Bold" FontSize="14" Foreground="#FFFFFF"/>
                        <TextBlock Text="Export AutoCAD 3D models and Plant 3D piping to the open IFC format" FontSize="11" Foreground="#9BA1A6"/>
                    </StackPanel>
                </StackPanel>
                <Button Grid.Column="1" VerticalAlignment="Center" Cursor="Hand" Background="#142C42" BorderBrush="#1F547E" BorderThickness="1" Padding="10,5" Click="BtnWebsite_Click" ToolTip="Original: baidurovlabs.ru. English fork: github.com/OneAndOnlyWahidHassani. Click to open the fork repository.">
                    <TextBlock Text="🌐 By baidurovlabs.ru · fork by Wahid Hassani" Foreground="#38BDF8" FontWeight="SemiBold" FontSize="11"/>
                </Button>
            </Grid>
        </Border>

        <!-- Output Path -->
        <GroupBox Grid.Row="1" Header="Output file (.ifc)" Padding="8" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="TxtOutputPath" Grid.Column="0" Height="25" VerticalContentAlignment="Center" Margin="0,0,8,0" FontWeight="Normal"/>
                <Button x:Name="BtnBrowse" Grid.Column="1" Content="Browse..." Width="75" Height="25" Background="#343944" BorderBrush="#4D5464" Foreground="#FFFFFF" Click="BtnBrowse_Click"/>
            </Grid>
        </GroupBox>

        <!-- 2-Column Settings (No Scrollbars) -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Column: Scope & Geometry -->
            <StackPanel Grid.Column="0" Margin="0,0,5,0">
                <GroupBox Header="IFC schema and scope" FontWeight="SemiBold" Padding="8" Margin="0,0,0,8">
                    <StackPanel>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Schema version:" VerticalAlignment="Center" FontWeight="Normal"/>
                            <ComboBox x:Name="CmbSchema" Grid.Column="1" Height="24" SelectedIndex="0" FontWeight="Normal">
                                <ComboBoxItem Content="IFC4 (Compact FaceSet)"/>
                                <ComboBoxItem Content="IFC2x3 (Coordination View)"/>
                            </ComboBox>
                        </Grid>

                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Scope:" VerticalAlignment="Center" FontWeight="Normal"/>
                            <ComboBox x:Name="CmbScope" Grid.Column="1" Height="24" SelectedIndex="0" FontWeight="Normal">
                                <ComboBoxItem Content="Entire current drawing"/>
                                <ComboBoxItem Content="Selected objects"/>
                                <ComboBoxItem Content="Visible layers"/>
                            </ComboBox>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Line filter:" VerticalAlignment="Center" FontWeight="Normal"/>
                            <TextBox x:Name="TxtLineFilter" Grid.Column="1" Height="22" VerticalContentAlignment="Center" FontWeight="Normal" ToolTip="Leave empty for all lines, or enter a line number"/>
                        </Grid>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Geometry and coordinates" FontWeight="SemiBold" Padding="8">
                    <StackPanel>
                        <Grid Margin="0,0,0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="145"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Vertex welding (mm):" VerticalAlignment="Center" FontWeight="Normal"/>
                            <TextBox x:Name="TxtTolerance" Grid.Column="1" Height="22" Text="0.5" VerticalContentAlignment="Center" FontWeight="Normal" ToolTip="Merges nearby points, reducing IFC file size by up to 70%"/>
                        </Grid>
                        <CheckBox x:Name="ChkMillimetres" Content="Units: Millimetres (Plant 3D)" IsChecked="True" FontWeight="Normal" Margin="0,0,0,5"/>
                        <CheckBox x:Name="ChkOffsetOrigin" Content="Offset coordinates to local origin" IsChecked="False" FontWeight="Normal" Checked="ChkOffsetOrigin_Changed" Unchecked="ChkOffsetOrigin_Changed" Margin="0,0,0,5"/>

                        <StackPanel x:Name="PanelOffsets" Orientation="Horizontal" Margin="10,0,0,0" Visibility="Collapsed">
                            <TextBlock Text="X:" VerticalAlignment="Center" Margin="0,0,2,0"/>
                            <TextBox x:Name="TxtOffX" Width="50" Height="20" Text="0.0" Margin="0,0,6,0"/>
                            <TextBlock Text="Y:" VerticalAlignment="Center" Margin="0,0,2,0"/>
                            <TextBox x:Name="TxtOffY" Width="50" Height="20" Text="0.0" Margin="0,0,6,0"/>
                            <TextBlock Text="Z:" VerticalAlignment="Center" Margin="0,0,2,0"/>
                            <TextBox x:Name="TxtOffZ" Width="50" Height="20" Text="0.0"/>
                        </StackPanel>
                    </StackPanel>
                </GroupBox>
            </StackPanel>

            <!-- Right Column: Properties & Metadata -->
            <StackPanel Grid.Column="1" Margin="5,0,0,0">
                <GroupBox Header="Properties and attributes (Pset)" FontWeight="SemiBold" Padding="8" Margin="0,0,0,8">
                    <StackPanel>
                        <CheckBox x:Name="ChkPlantProps" Content="Plant 3D properties (Line, Spec, DN)" IsChecked="True" FontWeight="Normal" Margin="0,0,0,5"/>
                        <CheckBox x:Name="ChkCadProps" Content="AutoCAD properties (Layer, Color, Handle)" IsChecked="True" FontWeight="Normal" Margin="0,0,0,5"/>
                        <CheckBox x:Name="ChkSkipEmpty" Content="Skip empty properties" IsChecked="True" FontWeight="Normal" Margin="0,0,0,5"/>

                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Pset prefix:" VerticalAlignment="Center" FontWeight="Normal"/>
                            <TextBox x:Name="TxtPsetPrefix" Grid.Column="1" Height="22" Text="Pset_Plant3D_Piping" VerticalContentAlignment="Center" FontWeight="Normal"/>
                        </Grid>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Project metadata" FontWeight="SemiBold" Padding="8">
                    <StackPanel>
                        <Grid Margin="0,0,0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Project name:" VerticalAlignment="Center" FontWeight="Normal"/>
                            <TextBox x:Name="TxtProjectName" Grid.Column="1" Height="22" Text="Plant Project" VerticalContentAlignment="Center" FontWeight="Normal"/>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Building / Site:" VerticalAlignment="Center" FontWeight="Normal"/>
                            <TextBox x:Name="TxtBuildingName" Grid.Column="1" Height="22" Text="Process Plant" VerticalContentAlignment="Center" FontWeight="Normal"/>
                        </Grid>
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </Grid>

        <!-- Progress and Status -->
        <StackPanel Grid.Row="3" Margin="0,6,0,6">
            <ProgressBar x:Name="PrgExport" Height="12" Value="0" Maximum="100"/>
            <TextBlock x:Name="TxtStatus" Text="Ready to export" Margin="0,3,0,0" FontSize="11" Foreground="#9BA1A6"/>
        </StackPanel>

        <!-- Action Buttons -->
        <Border Grid.Row="4" BorderBrush="#383E4A" BorderThickness="0,1,0,0" Padding="0,8,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="BtnExport" Grid.Column="1" Content="Export to IFC" Width="170" Height="30" Background="#0E70C0" BorderBrush="#1884DD" Foreground="White" FontWeight="SemiBold" Margin="0,0,8,0" Click="BtnExport_Click"/>
                <Button x:Name="BtnCancel" Grid.Column="2" Content="Close" Width="80" Height="30" Background="#343944" BorderBrush="#4D5464" Foreground="#FFFFFF" Click="BtnCancel_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>
